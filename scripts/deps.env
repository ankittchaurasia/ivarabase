# Pinned dependency versions, shared by scripts/install-deps-ubuntu.sh and the
# Dockerfile so they can't drift apart. Bump together with a test run
# (make selftest). Sourced by bash; ARCH must be amd64 or arm64.
PG_MAJOR=18                 # minor updates (18.x) come from apt with security fixes
POSTGREST_VERSION=16.5
DENO_VERSION=2.9.8
case "${ARCH:-$(uname -m)}" in
  x86_64|amd64)
    POSTGREST_ASSET=postgrest-v$POSTGREST_VERSION-linux-static-x86-64.tar.xz
    POSTGREST_SHA256=5099e7ada38f9f6846cd87c14c5f158b7c165f1e9959665ad412e61f4dceba95
    DENO_ASSET=deno-x86_64-unknown-linux-gnu.zip
    DENO_SHA256=e890975bc2549807bbcc0b584ffafda72cc7c93349dd99c80483dd784f6c4609
    BIN_ARCH=amd64 ;;
  aarch64|arm64)
    POSTGREST_ASSET=postgrest-v$POSTGREST_VERSION-linux-static-aarch64.tar.xz
    POSTGREST_SHA256=96d75a34c7c095d5f97b87f88042f898192724350861328db9e1509e696ea057
    DENO_ASSET=deno-aarch64-unknown-linux-gnu.zip
    DENO_SHA256=d49596c20b9788cf8f5d8ddf644103d4bde56ed239753f0bdb92ba9361d51905
    BIN_ARCH=arm64 ;;
  *) echo "unsupported architecture $(uname -m) (amd64 and arm64 are supported)"; exit 1 ;;
esac
