# Development-only settings for `make dev` (scripts/dev.sh).
# The dev instance keeps its data in ./.dev-data, separate from a real install
# in ~/.ivarabase, and uses its own Postgres port so both can run on one Mac.
# This login exists only in the local dev instance. Never reuse it anywhere else.

IVARA_DEV_DATA="${IVARA_DEV_DATA:-$PWD/.dev-data}"
IVARA_DEV_USER=admin
IVARA_DEV_PASSWORD=ivara-dev-pass
IVARA_DEV_PG_PORT=54330

