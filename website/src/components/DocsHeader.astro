---
// Replaces Starlight's header so the docs share the landing page's header:
// logo, the same links, search, GitHub, and the same light/dark switch.
import Search from 'virtual:starlight/components/Search';
import { REPO } from '../../docs.manifest.mjs';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const doc = (slug: string) => `${base}docs/${slug}/`;
const current = Astro.url.pathname;
const links = [
	{ label: 'Product', href: `${base}#features` },
	{ label: 'Docs', href: doc('docker'), active: current.startsWith(`${base}docs/`) && !current.includes('/comparison') },
	{ label: 'Compare', href: doc('comparison'), active: current.includes('/comparison') },
	{ label: 'Changelog', href: `${REPO}/releases` },
];
---

<div class="ib-header">
	<a href={base} class="ib-brand" aria-label="IvaraBase home">
		<img src={`${base}favicon.svg`} alt="" width="26" height="26" />
		<span>IvaraBase</span>
	</a>
	<nav class="ib-links" aria-label="Main">
		{links.map((l) => <a href={l.href} class:list={{ active: l.active }} aria-current={l.active ? 'page' : undefined}>{l.label}</a>)}
	</nav>
	<div class="ib-search print:hidden"><Search /></div>
	<div class="ib-right print:hidden">
		<button class="ib-theme" type="button" aria-label="Switch between light and dark" title="Switch theme">
			<svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
			<svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
		</button>
		<a class="ib-gh" href={REPO} aria-label="IvaraBase on GitHub">
			<svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
			<span>Star</span>
		</a>
		<a class="ib-start" href={doc('docker')}>Get started</a>
	</div>
</div>

<script>
	document.querySelectorAll('.ib-theme').forEach((b) =>
		b.addEventListener('click', () => {
			const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
			document.documentElement.dataset.theme = next;
			try {
				localStorage.setItem('starlight-theme', next);
			} catch {}
		}),
	);
</script>

<style>
	.ib-header {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		height: 100%;
	}
	.ib-brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font-weight: 700;
		font-size: 1.05rem;
		color: var(--sl-color-white);
		text-decoration: none;
		flex-shrink: 0;
	}
	.ib-brand img {
		border-radius: 7px;
	}
	.ib-links {
		display: none;
		gap: 1.3rem;
		font-size: 0.875rem;
	}
	.ib-links a {
		color: var(--sl-color-gray-3);
		text-decoration: none;
	}
	.ib-links a:hover,
	.ib-links a.active {
		color: var(--sl-color-white);
	}
	.ib-search {
		flex: 1;
		display: flex;
		justify-content: flex-end;
	}
	.ib-right {
		display: none;
		align-items: center;
		gap: 0.6rem;
	}
	.ib-theme,
	.ib-gh {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		height: 2.1rem;
		padding: 0 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 8px;
		background: transparent;
		color: var(--sl-color-gray-3);
		font: inherit;
		font-size: 0.8125rem;
		text-decoration: none;
		cursor: pointer;
	}
	.ib-theme {
		width: 2.1rem;
		padding: 0;
	}
	.ib-theme:hover,
	.ib-gh:hover {
		color: var(--sl-color-white);
		border-color: var(--sl-color-gray-4);
	}
	.ib-theme svg,
	.ib-gh svg {
		width: 15px;
		height: 15px;
	}
	:global(:root[data-theme='light']) .ib-theme .moon,
	:global(:root:not([data-theme='light'])) .ib-theme .sun {
		display: none;
	}
	.ib-start {
		display: inline-flex;
		align-items: center;
		height: 2.1rem;
		padding: 0 0.9rem;
		border-radius: 8px;
		background: var(--sl-color-white);
		color: var(--sl-color-black);
		font-weight: 600;
		font-size: 0.84rem;
		text-decoration: none;
	}
	.ib-start:hover {
		opacity: 0.88;
	}
	@media (min-width: 50rem) {
		.ib-right {
			display: flex;
		}
		.ib-search {
			justify-content: center;
		}
	}
	@media (min-width: 72rem) {
		.ib-links {
			display: flex;
		}
	}
</style>
